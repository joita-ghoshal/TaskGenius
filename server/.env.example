# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL (Supabase/Neon/Render)
# Local: postgresql://postgres:password@localhost:5432/taskgenius
# Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
# Neon: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskgenius

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides. Default works on the free tier; the fallback chain handles
# retired/overloaded models automatically.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000

# Client URL(s) (for CORS) - comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173

# Email reminders + password reset (optional). Leave blank to keep email disabled.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Browser push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taskgenius.app

# Background maintenance + internal cron
CRON_SECRET=change-me
SCHEDULER_INTERVAL_MS=300000
# DISABLE_SCHEDULER=true
